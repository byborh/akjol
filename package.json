{
  "name": "akjol",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:akjol": "drizzle-kit akjol",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "promote:curator": "tsx --env-file=.env.local scripts/promote-curator.ts",
    "import:schools": "tsx --env-file=.env.local scripts/import-schools.ts",
    "seed:jobs-tech": "tsx --env-file=.env.local scripts/seed-jobs-tech.ts",
    "seed:iut": "tsx --env-file=.env.local scripts/seed-iut.ts",
    "seed:equivalences": "tsx --env-file=.env.local scripts/seed-equivalences.ts",
    "build:bts-sio-csv": "tsx scripts/build-bts-sio-csv.ts",
    "enrich:rules": "tsx --env-file=.env.local scripts/enrich-rules.ts",
    "enrich:llm": "tsx --env-file=.env.local scripts/enrich-llm.ts",
    "import:programs": "tsx --env-file=.env.local scripts/import-programs-csv.ts",
    "ingest": "pnpm --filter @akjol/ingest ingest",
    "ingest:onisep": "pnpm --filter @akjol/ingest ingest:onisep",
    "ingest:parcoursup": "pnpm --filter @akjol/ingest ingest:parcoursup",
    "ingest:parcoursup:it": "pnpm --filter @akjol/ingest ingest:parcoursup:it",
    "ingest:mon-master": "pnpm --filter @akjol/ingest ingest:mon-master",
    "ingest:ucas": "pnpm --filter @akjol/ingest ingest:ucas",
    "ingest:common-app": "pnpm --filter @akjol/ingest ingest:common-app",
    "ingest:all": "pnpm --filter @akjol/ingest ingest:all"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "^0.36.4"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "sharp"
    ]
  }
}
