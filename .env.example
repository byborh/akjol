# ─── Auth ─────────────────────────────────────────────────────────────
# Cookie de session HMAC. Génère un secret long aléatoire en prod
# (ex: `openssl rand -hex 32`). En dev, la valeur par défaut suffit.
AKJOL_SESSION_SECRET=change-me-in-production-32-bytes-min

# ─── Google OAuth ─────────────────────────────────────────────────────
# Optionnel en dev — sans ces variables, le bouton « Continuer avec Google »
# renvoie un 503 propre, mais l'auth email/password fonctionne quand même.
#
# Setup :
#   1. https://console.cloud.google.com/apis/credentials
#   2. « Créer des identifiants » → « ID client OAuth » → Web application
#   3. URI de redirection autorisé en local :
#        http://localhost:3000/api/auth/google/callback
#   4. Copie ici Client ID + Client Secret
GOOGLE_CLIENT_ID=PLACEHOLDER_REPLACE_WITH_REAL_VALUE.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=PLACEHOLDER_REPLACE_WITH_REAL_VALUE

# ─── Base de données ──────────────────────────────────────────────────
# SQLite local. Par défaut : ./data/akjol.db (résolu depuis la racine repo).
# AKJOL_DB=/chemin/absolu/vers/akjol.db

# ─── Turso (prod uniquement) ──────────────────────────────────────────
# Si TURSO_DATABASE_URL est défini, le driver bascule sur @libsql/client
# (compatible Vercel/edge). Sinon, on tombe sur better-sqlite3 + le fichier
# local ci-dessus. C'est le branchement automatique dev/prod.
#
# Setup :
#   1. Compte sur https://turso.tech (signin GitHub)
#   2. CLI : irm get.tur.so/install.ps1 | iex
#   3. turso auth login
#   4. turso db create akjol-prod --location cdg     (Paris, RGPD-friendly)
#   5. turso db show akjol-prod --url                → coller dans TURSO_DATABASE_URL
#   6. turso db tokens create akjol-prod             → coller dans TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── URL publique ─────────────────────────────────────────────────────
# Dev : http://localhost:3000
# Prod : https://akjol.fr (ou ton domaine de test)
# Utilisée pour les callbacks OAuth, emails, et liens absolus. Sans trailing slash.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
