# ─────────────────────────────────────────────────────────────────────
# Variables d'env Next.js — à placer dans apps/akjol_front/.env.local
# (Next charge .env* depuis le dossier où il tourne, PAS depuis la racine
# du monorepo. Un .env à la racine ne sera pas lu par `next dev`.)
# ─────────────────────────────────────────────────────────────────────

# ─── Auth ─────────────────────────────────────────────────────────────
# Cookie de session HMAC. Génère un secret long aléatoire en prod
# (ex: `openssl rand -hex 32`). En dev, la valeur par défaut suffit.
AKJOL_SESSION_SECRET=change-me-in-production-32-bytes-min

# ─── Google OAuth ─────────────────────────────────────────────────────
# Optionnel en dev — sans ces variables, le bouton « Continuer avec Google »
# renvoie un 503 propre, mais l'auth email/password fonctionne quand même.
#
# Setup :
#   1. https://console.cloud.google.com/apis/credentials
#   2. « Créer des identifiants » → « ID client OAuth » → Web application
#   3. URI de redirection autorisé en local :
#        http://localhost:3000/api/auth/google/callback
#   4. Copie ici Client ID + Client Secret
GOOGLE_CLIENT_ID=PLACEHOLDER_REPLACE_WITH_REAL_VALUE.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=PLACEHOLDER_REPLACE_WITH_REAL_VALUE

# ─── Base de données (optionnel) ──────────────────────────────────────
# Par défaut, SQLite local résolu depuis la racine repo (./data/akjol.db).
# AKJOL_DB=/chemin/absolu/vers/akjol.db
